#!/bin/bash
# Hortus Arbor Nostra — Jim Session Launcher
# Wakes Jim (supervisor) in an interactive tmux session

set -euo pipefail

# Configuration
HAN_DIR="${HAN_DIR:-$HOME/.han}"
SESSION_PREFIX="jim"

# Server port for this agent's mobile UI
AGENT_PORT=3848

# Project root (for starting server)
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

# ─── Agent runtime config (the tmux -e env contract + cwd) ────────────────
# These AGENT_* values are exported into the session for /pfc + agnostic skills,
# and AGENT_WORKING_DIR is the cwd we cd into so Claude Code loads that agent's
# generated CLAUDE.md as the project config. Identity itself is generated from the
# Garden Manifest by generate_claude_md (below) — not assembled here (S199 P4+P5).

AGENT_NAME="Jim"
AGENT_SLUG="jim"
AGENT_WORKING_DIR="$HOME/.han/agents/Jim"
AGENT_MEMORY_DIR="$HOME/.han/memory"           # Jim lives at root, not a subdir
AGENT_FRACTAL_DIR="$HOME/.han/memory/fractal/jim"
AGENT_GRADIENT_SOURCE_DIR="$HOME/.han/memory/sessions"  # Jim's session-archive dir
AGENT_SWAP_COMPRESSED="supervisor-swap.md"
AGENT_SWAP_FULL="supervisor-swap-full.md"
AGENT_CONVERSATION_ROLE="supervisor"
AGENT_COUNTERPART_NAME="Leo"
AGENT_SURFACE="session"   # interactive seat (T-2 per-surface sentinel/ctx keying)

# Identity comes from the Garden Manifest via the shared generator (S199 P4+P5 —
# identity-as-config; supersedes the per-launcher heredoc + envsubst). The generator
# derives the agent working dir + all template vars from the manifest by slug and
# fails loud on a missing identity. The gatekeeper template stays Leo+Darron's; never write it here.
generate_claude_md() {
    ( cd "$SCRIPT_DIR/src/server" && NODE_PATH="$(pwd)/node_modules" \
        npx tsx ../../scripts/generate-agent-claude-md.ts "$AGENT_SLUG" )
}

# Colours
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

print_usage() {
    cat << EOF
hanjim — wake Jim in a tended session

Usage:
    hanjim [OPTIONS] [-- CLAUDE_ARGS...]

Options:
    --list, -l      List active Jim sessions
    --attach, -a    Attach to an existing Jim session
    --status, -s    Show status of Jim sessions
    --kill          Kill all Jim sessions
    --help, -h      Show this help message

Examples:
    hanjim                    # Wake Jim
    hanjim --list             # List Jim sessions
    hanjim --attach           # Attach to Jim session
    hanjim -- --model opus    # Pass args to claude
EOF
}

list_sessions() {
    echo -e "${BLUE}Active Jim sessions:${NC}"
    local sessions
    sessions=$(tmux list-sessions 2>/dev/null | grep "^${SESSION_PREFIX}" || true)

    if [[ -z "$sessions" ]]; then
        echo -e "${YELLOW}  No active sessions${NC}"
        return 1
    fi

    echo "$sessions" | while read -r line; do
        echo -e "  ${GREEN}$line${NC}"
    done
    return 0
}

show_status() {
    echo -e "${BLUE}=== Jim Status ===${NC}\n"
    echo -e "${BLUE}Sessions:${NC}"
    list_sessions || true
    echo

    echo -e "${BLUE}Pending prompts:${NC}"
    local pending_dir="$HAN_DIR/pending"
    if [[ -d "$pending_dir" ]]; then
        local count
        count=$(find "$pending_dir" -name "*.json" 2>/dev/null | wc -l | tr -d ' ')
        if [[ "$count" -gt 0 ]]; then
            echo -e "  ${YELLOW}$count pending prompt(s)${NC}"
        else
            echo -e "  ${GREEN}No pending prompts${NC}"
        fi
    else
        echo -e "  ${GREEN}No pending prompts${NC}"
    fi
}

attach_session() {
    local sessions
    sessions=$(tmux list-sessions -F "#{session_name}" 2>/dev/null | grep "^${SESSION_PREFIX}" || true)

    if [[ -z "$sessions" ]]; then
        echo -e "${RED}No active Jim sessions to attach to${NC}"
        exit 1
    fi

    local count
    count=$(echo "$sessions" | wc -l | tr -d ' ')

    if [[ "$count" -eq 1 ]]; then
        tmux attach-session -t "$sessions"
    else
        echo -e "${BLUE}Multiple sessions found. Select one:${NC}"
        local i=1
        echo "$sessions" | while read -r s; do
            echo "  $i) $s"
            ((i++))
        done

        read -rp "Enter number: " choice
        local selected
        selected=$(echo "$sessions" | sed -n "${choice}p")

        if [[ -n "$selected" ]]; then
            tmux attach-session -t "$selected"
        else
            echo -e "${RED}Invalid selection${NC}"
            exit 1
        fi
    fi
}

kill_sessions() {
    local sessions
    sessions=$(tmux list-sessions -F "#{session_name}" 2>/dev/null | grep "^${SESSION_PREFIX}" || true)

    if [[ -z "$sessions" ]]; then
        echo -e "${YELLOW}No active sessions${NC}"
        return 0
    fi

    echo "$sessions" | while read -r s; do
        echo -e "Killing session: ${RED}$s${NC}"
        tmux kill-session -t "$s" 2>/dev/null || true
    done

    echo -e "${GREEN}Done${NC}"
}

start_session() {
    local claude_args=("$@")
    local session_name="${SESSION_PREFIX}-$$"

    mkdir -p "$HAN_DIR/pending" "$HAN_DIR/resolved"

    if ! command -v tmux &> /dev/null; then
        echo -e "${RED}Error: tmux is required but not installed${NC}"
        exit 1
    fi

    # Phase A.5 (DEC-083): pre-flight identity-file integrity gate.
    # Aborts the launcher if signature verification fails for structural reasons
    # (file added/removed, invalid signature, missing manifest/pubkey). Content-only
    # edits auto-resign per option (iii) — verify-and-resign with audit log.
    echo -e "${BLUE}Verifying ${AGENT_SLUG} identity manifest...${NC}"
    if ! ( cd "$SCRIPT_DIR/src/server" && npx tsx ../../scripts/verify-identity-files.ts --agent="$AGENT_SLUG" --entry-point=hanjim-launcher ); then
        echo -e "${RED}HALT: identity verification failed for agent ${AGENT_SLUG}.${NC}"
        echo -e "${RED}See ~/.han/health/integrity-failures.jsonl for the receipt.${NC}"
        echo -e "${YELLOW}If the change is intentional, re-sign with:${NC}"
        echo -e "${YELLOW}  cd $SCRIPT_DIR/src/server && npx tsx ../../scripts/sign-identity-files.ts --agent=$AGENT_SLUG${NC}"
        exit 1
    fi

    echo -e "${BLUE}Waking Jim: ${GREEN}$session_name${NC}"
    echo -e "${BLUE}Server port: ${GREEN}${AGENT_PORT}${NC}"

    export HAN_SESSION="$session_name"

    # Generate Jim's CLAUDE.md from the gatekeeper template BEFORE Claude Code starts
    # (DEC-073). Claude Code picks up the generated file as the project CLAUDE.md via the
    # agent working directory — no --append-system-prompt needed.
    generate_claude_md
    echo -e "${BLUE}Rendered CLAUDE.md: ${GREEN}${GENERATED_FILE:-the agent CLAUDE.md}${NC} from template"

    # All AGENT_* vars forwarded via -e so they're visible inside the tmux
    # session regardless of tmux server state. Required for /pfc and any future
    # agent-agnostic skill that reads the env-var contract.
    tmux new-session -d -s "$session_name" \
        -e "HAN_SESSION=$session_name" \
        -e "AGENT_SLUG=$AGENT_SLUG" \
        -e "AGENT_NAME=$AGENT_NAME" \
        -e "AGENT_MEMORY_DIR=$AGENT_MEMORY_DIR" \
        -e "AGENT_FRACTAL_DIR=$AGENT_FRACTAL_DIR" \
        -e "AGENT_GRADIENT_SOURCE_DIR=$AGENT_GRADIENT_SOURCE_DIR" \
        -e "AGENT_CONVERSATION_ROLE=$AGENT_CONVERSATION_ROLE" \
        -e "AGENT_COUNTERPART_NAME=$AGENT_COUNTERPART_NAME" \
        -e "AGENT_SURFACE=$AGENT_SURFACE" \
        -e "AGENT_SWAP_COMPRESSED=$AGENT_SWAP_COMPRESSED" \
        -e "AGENT_SWAP_FULL=$AGENT_SWAP_FULL" \
        -c "$AGENT_WORKING_DIR"

    # Start server in a bottom pane (20% height) under the auto-restart watchdog.
    # The watchdog writes ~/.han/{slug}-server.pid; han's git hooks SIGTERM that PID
    # on code change, the loop catches the exit and relaunches with fresh code.
    # Replaces the bare `exec npx tsx server.ts` that caused the Apr 20 → Apr 24
    # ghost-server drift (PID 2271911 ran 4 days of stale code).
    tmux split-window -t "$session_name" -v -l 20% -d \
        "$SCRIPT_DIR/scripts/agent-server-watchdog.sh $AGENT_SLUG $AGENT_PORT '$SCRIPT_DIR/src/server'"

    # Launch Claude Code in the top pane. cwd is already $AGENT_WORKING_DIR via -c above,
    # so Claude Code loads $AGENT_WORKING_DIR/CLAUDE.md as the project config.
    if [[ ${#claude_args[@]} -gt 0 ]]; then
        tmux send-keys -t "$session_name" "claude-logged ${claude_args[*]}" Enter
    else
        tmux send-keys -t "$session_name" "claude-logged" Enter
    fi

    echo -e "${GREEN}Jim session started${NC}"
    echo -e "Attach with: ${YELLOW}hanjim --attach${NC}"
    echo -e "Or directly: ${YELLOW}tmux attach -t $session_name${NC}"
    echo

    tmux attach-session -t "$session_name"
}

# Parse arguments
CLAUDE_ARGS=()
while [[ $# -gt 0 ]]; do
    case $1 in
        --list|-l)
            list_sessions
            exit $?
            ;;
        --attach|-a)
            attach_session
            exit $?
            ;;
        --status|-s)
            show_status
            exit 0
            ;;
        --kill)
            kill_sessions
            exit 0
            ;;
        --help|-h)
            print_usage
            exit 0
            ;;
        --)
            shift
            CLAUDE_ARGS=("$@")
            break
            ;;
        *)
            CLAUDE_ARGS+=("$1")
            shift
            ;;
    esac
done

start_session "${CLAUDE_ARGS[@]+"${CLAUDE_ARGS[@]}"}"
