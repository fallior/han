#!/bin/bash
# Hortus Arbor Nostra — Tenshi Session Launcher
# Wakes Tenshi (security/vulnerability agent) in a tmux session

set -euo pipefail

# MNT-089-family divergence guard (Tenshi+Casey merged instrument, msb5c2tb 2026-08-06):
# an uncrowned twin must never wake garden minds — but a CROWNED twin (real recovery,
# UNMASK step 5) must. Keyed on the one file guard and ceremony share; ambiguity refuses.
if [ -e /etc/han-twin-status ] && ! grep -q '^CROWNED' /etc/han-twin-status; then
  echo "REFUSED: this box declares itself an uncrowned twin — garden minds do not wake here."
  cat /etc/han-twin-status
  exit 1
fi

# Configuration
HAN_DIR="${HAN_DIR:-$HOME/.han}"
SESSION_PREFIX="tenshi"

# Server port for this agent's mobile UI
AGENT_PORT=3849

# ─── Agent identity (DEC-073 templated CLAUDE.md) ─────────────────────────
AGENT_NAME="Tenshi"
AGENT_SLUG="tenshi"
AGENT_WORKING_DIR="$HOME/.han/agents/Tenshi"
AGENT_MEMORY_DIR="$HOME/.han/memory/tenshi"
AGENT_FRACTAL_DIR="$HOME/.han/memory/fractal/tenshi"
AGENT_GRADIENT_SOURCE_DIR="$HOME/.han/memory/tenshi/working-memories"
AGENT_SWAP_COMPRESSED="session-swap.md"
AGENT_SWAP_FULL="session-swap-full.md"
AGENT_CONVERSATION_ROLE="tenshi"
AGENT_COUNTERPART_NAME="Leo"
AGENT_SURFACE="session"   # interactive seat (T-2 per-surface sentinel/ctx keying)

# Identity comes from the Garden Manifest via the shared generator (S199 P4+P5 —
# identity-as-config; supersedes the per-launcher heredoc + envsubst). The generator
# derives the agent working dir + all template vars from the manifest by slug and
# fails loud on a missing identity. The gatekeeper template stays Leo+Darron's; never write it here.
generate_claude_md() {
    ( cd "$SCRIPT_DIR/src/server" && NODE_PATH="$(pwd)/node_modules" \
        npx tsx ../../scripts/generate-agent-claude-md.ts "$AGENT_SLUG" )
}

# Project root (for starting server)
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

# Colours
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

print_usage() {
    cat << EOF
hantenshi — wake Tenshi in a tended session

Usage:
    hantenshi [OPTIONS] [-- CLAUDE_ARGS...]

Options:
    --list, -l      List active Tenshi sessions
    --attach, -a    Attach to an existing Tenshi session
    --status, -s    Show status of Tenshi sessions
    --kill          Kill all Tenshi sessions
    --warm          Check out a pre-warmed pool stem (the DEFAULT since 2026-08-19,
                    per the msz950i2 design — shared leg, DEC-081). Falls back cold.
    --cold          Force the classic cold launch (the escape hatch; -- claude args
                    also imply cold — a running stem cannot take launch flags)
    fable|opus|sonnet|haiku   Cast the checked-out stem to this model family
    --help, -h      Show this help message

Examples:
    hantenshi                    # Wake Tenshi
    hantenshi --list             # List Tenshi sessions
    hantenshi --attach           # Attach to Tenshi session
    hantenshi -- --model opus    # Pass args to claude
EOF
}

list_sessions() {
    echo -e "${BLUE}Active Tenshi sessions:${NC}"
    local sessions
    sessions=$(tmux list-sessions 2>/dev/null | grep "^${SESSION_PREFIX}" || true)

    if [[ -z "$sessions" ]]; then
        echo -e "${YELLOW}  No active sessions${NC}"
        return 1
    fi

    echo "$sessions" | while read -r line; do
        echo -e "  ${GREEN}$line${NC}"
    done
    return 0
}

show_status() {
    echo -e "${BLUE}=== Tenshi Status ===${NC}\n"
    echo -e "${BLUE}Sessions:${NC}"
    list_sessions || true
    echo

    echo -e "${BLUE}Pending prompts:${NC}"
    local pending_dir="$HAN_DIR/pending"
    if [[ -d "$pending_dir" ]]; then
        local count
        count=$(find "$pending_dir" -name "*.json" 2>/dev/null | wc -l | tr -d ' ')
        if [[ "$count" -gt 0 ]]; then
            echo -e "  ${YELLOW}$count pending prompt(s)${NC}"
        else
            echo -e "  ${GREEN}No pending prompts${NC}"
        fi
    else
        echo -e "  ${GREEN}No pending prompts${NC}"
    fi
}

attach_session() {
    local sessions
    sessions=$(tmux list-sessions -F "#{session_name}" 2>/dev/null | grep "^${SESSION_PREFIX}" || true)

    if [[ -z "$sessions" ]]; then
        echo -e "${RED}No active Tenshi sessions to attach to${NC}"
        exit 1
    fi

    local count
    count=$(echo "$sessions" | wc -l | tr -d ' ')

    if [[ "$count" -eq 1 ]]; then
        tmux attach-session -t "$sessions"
    else
        echo -e "${BLUE}Multiple sessions found. Select one:${NC}"
        local i=1
        echo "$sessions" | while read -r s; do
            echo "  $i) $s"
            ((i++))
        done

        read -rp "Enter number: " choice
        local selected
        selected=$(echo "$sessions" | sed -n "${choice}p")

        if [[ -n "$selected" ]]; then
            tmux attach-session -t "$selected"
        else
            echo -e "${RED}Invalid selection${NC}"
            exit 1
        fi
    fi
}

# ── Warm checkout — SHARED leg (DEC-081: one path, many agents) ──────────────
# ensure_server + warm_checkout live in scripts/lib/launcher-warm-checkout.sh —
# the same audited functions hanleo/hanjim source (msz950i2 design, extracted 2026-08-19).
source "$SCRIPT_DIR/scripts/lib/launcher-warm-checkout.sh"

kill_sessions() {
    local sessions
    sessions=$(tmux list-sessions -F "#{session_name}" 2>/dev/null | grep "^${SESSION_PREFIX}" || true)

    if [[ -z "$sessions" ]]; then
        echo -e "${YELLOW}No active sessions${NC}"
        return 0
    fi

    echo "$sessions" | while read -r s; do
        echo -e "Killing session: ${RED}$s${NC}"
        tmux kill-session -t "$s" 2>/dev/null || true
    done

    echo -e "${GREEN}Done${NC}"
}

start_session() {
    local claude_args=("$@")
    local session_name="${SESSION_PREFIX}-$$"

    mkdir -p "$HAN_DIR/pending" "$HAN_DIR/resolved"

    if ! command -v tmux &> /dev/null; then
        echo -e "${RED}Error: tmux is required but not installed${NC}"
        exit 1
    fi

    # Phase A.5 (DEC-083): pre-flight identity-file integrity gate.
    # Backfilled S226 (the scour, N1): hanleo/hanjim carried this; the tenshi/casey
    # copies drifted without it. Aborts the launcher on structural verification
    # failure; content-only edits auto-resign per option (iii).
    echo -e "${BLUE}Verifying ${AGENT_SLUG} identity manifest...${NC}"
    if ! ( cd "$SCRIPT_DIR/src/server" && npx tsx ../../scripts/verify-identity-files.ts --agent="$AGENT_SLUG" --entry-point=hantenshi-launcher ); then
        echo -e "${RED}HALT: identity verification failed for agent ${AGENT_SLUG}.${NC}"
        echo -e "${RED}See ~/.han/health/integrity-failures.jsonl for the receipt.${NC}"
        echo -e "${YELLOW}If the change is intentional, re-sign with:${NC}"
        echo -e "${YELLOW}  cd $SCRIPT_DIR/src/server && npx tsx ../../scripts/sign-identity-files.ts --agent=$AGENT_SLUG${NC}"
        exit 1
    fi

    echo -e "${BLUE}Waking Tenshi: ${GREEN}$session_name${NC}"
    echo -e "${BLUE}Server port: ${GREEN}${AGENT_PORT}${NC}"

    export HAN_SESSION="$session_name"

    # Render Tenshi's CLAUDE.md from the gatekeeper template (DEC-073)
    generate_claude_md
    echo -e "${BLUE}Rendered CLAUDE.md: ${GREEN}${GENERATED_FILE:-the agent CLAUDE.md}${NC} from template"

    # All AGENT_* vars forwarded via -e so they're visible inside the tmux
    # session regardless of tmux server state. Required for /pfc and any future
    # agent-agnostic skill that reads the env-var contract.
    tmux new-session -d -s "$session_name" \
        -e "HAN_SESSION=$session_name" \
        -e "AGENT_SLUG=$AGENT_SLUG" \
        -e "AGENT_NAME=$AGENT_NAME" \
        -e "AGENT_MEMORY_DIR=$AGENT_MEMORY_DIR" \
        -e "AGENT_FRACTAL_DIR=$AGENT_FRACTAL_DIR" \
        -e "AGENT_GRADIENT_SOURCE_DIR=$AGENT_GRADIENT_SOURCE_DIR" \
        -e "AGENT_CONVERSATION_ROLE=$AGENT_CONVERSATION_ROLE" \
        -e "AGENT_COUNTERPART_NAME=$AGENT_COUNTERPART_NAME" \
        -e "AGENT_SURFACE=$AGENT_SURFACE" \
        -e "AGENT_SWAP_COMPRESSED=$AGENT_SWAP_COMPRESSED" \
        -e "AGENT_SWAP_FULL=$AGENT_SWAP_FULL" \
        -c "$AGENT_WORKING_DIR"

    # Server in bottom pane under auto-restart watchdog (see hanjim for rationale).
    # F-J1 (msz950i2 diff-audit, applied to every launcher): never stack a second
    # server — a pane twin cannot bind, crash-loops, and clobbers the PID file that
    # deploy-restarts SIGTERM. One server per identity, whoever started it.
    if curl -sk -o /dev/null -m 3 "https://localhost:${AGENT_PORT}/api/analytics" 2>/dev/null; then
        echo -e "${GREEN}Server already answering on ${AGENT_PORT} — not spawning a second (F-J1)${NC}"
    else
        tmux split-window -t "$session_name" -v -l 20% -d \
            "$SCRIPT_DIR/scripts/agent-server-watchdog.sh $AGENT_SLUG $AGENT_PORT '$SCRIPT_DIR/src/server'"
    fi

    # Launch Claude Code in the top pane. cwd is $AGENT_WORKING_DIR so Claude Code loads
    # the generated CLAUDE.md as the project config — no --append-system-prompt needed.
    if [[ ${#claude_args[@]} -gt 0 ]]; then
        tmux send-keys -t "$session_name" "claude-logged ${claude_args[*]}" Enter
    else
        tmux send-keys -t "$session_name" "claude-logged" Enter
    fi

    echo -e "${GREEN}Tenshi session started${NC}"
    echo -e "Attach with: ${YELLOW}hantenshi --attach${NC}"
    echo -e "Or directly: ${YELLOW}tmux attach -t $session_name${NC}"
    echo

    tmux attach-session -t "$session_name"
}

# Parse arguments
CLAUDE_ARGS=()
WARM_MODE=1      # DEFAULT (2026-08-19, the msz950i2 design per DEC-081 — third/fourth agent for free)
CAST_MODEL="fable"   # bare alias, DEC-104
while [[ $# -gt 0 ]]; do
    case $1 in
        --warm)
            WARM_MODE=1
            shift
            ;;
        --cold)
            WARM_MODE=0
            shift
            ;;
        fable|opus|sonnet|haiku)
            CAST_MODEL="$1"
            WARM_MODE=1
            shift
            ;;
        --list|-l)
            list_sessions
            exit $?
            ;;
        --attach|-a)
            attach_session
            exit $?
            ;;
        --status|-s)
            show_status
            exit 0
            ;;
        --kill)
            kill_sessions
            exit 0
            ;;
        --help|-h)
            print_usage
            exit 0
            ;;
        --)
            shift
            CLAUDE_ARGS=("$@")
            break
            ;;
        *)
            CLAUDE_ARGS+=("$1")
            shift
            ;;
    esac
done

# Explicit claude args imply the cold path — a running stem cannot take launch flags.
if [[ ${#CLAUDE_ARGS[@]} -gt 0 ]]; then
    WARM_MODE=0
fi

if [[ "$WARM_MODE" -eq 1 ]]; then
    warm_checkout "$CAST_MODEL" && exit 0
    # fallthrough = cold fallback, byte-identical classic path
fi

start_session "${CLAUDE_ARGS[@]+"${CLAUDE_ARGS[@]}"}"
