#!/bin/bash
# Hortus Arbor Nostra — Leo Session Launcher
# Wakes Leo (session agent) in a tmux session

set -euo pipefail

# MNT-089-family divergence guard (Tenshi+Casey merged instrument, msb5c2tb 2026-08-06):
# an uncrowned twin must never wake garden minds — but a CROWNED twin (real recovery,
# UNMASK step 5) must. Keyed on the one file guard and ceremony share; ambiguity refuses.
if [ -e /etc/han-twin-status ] && ! grep -q '^CROWNED' /etc/han-twin-status; then
  echo "REFUSED: this box declares itself an uncrowned twin — garden minds do not wake here."
  cat /etc/han-twin-status
  exit 1
fi

# Configuration
HAN_DIR="${HAN_DIR:-$HOME/.han}"
SESSION_PREFIX="leo"

# Leo is the default identity in CLAUDE.md — no override needed

# Server port for this agent's mobile UI
AGENT_PORT=3847

# Agent runtime config exports — symmetric with hanjim/hancasey/hantenshi.
# Per the aphorism *"HAN should always be written agent-agnostic"*, every
# launcher exports the same env-var contract; agnostic code reads the vars
# rather than branching on slug literals. Leo is de-special-cased (S198 Phase 1 +
# S199 P4+P5): identity is generated from the Garden Manifest like every agent.
AGENT_SLUG="leo"
AGENT_NAME="Leo"
AGENT_MEMORY_DIR="$HOME/.han/memory/leo"
AGENT_FRACTAL_DIR="$HOME/.han/memory/fractal/leo"
AGENT_GRADIENT_SOURCE_DIR="$HOME/.han/memory/leo/working-memories"
AGENT_CONVERSATION_ROLE="leo"
AGENT_COUNTERPART_NAME="Jim"
AGENT_SURFACE="session"   # interactive seat (T-2 per-surface sentinel/ctx keying)

# Project root (for starting server)
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

# ─── Agent runtime config (the tmux -e env contract + cwd) ────────────────
# Leo de-special-cased (S198 Phase 1 → S199 P4+P5): like every agent, Leo's identity
# is generated from the Garden Manifest by generate_claude_md (below) into
# ~/.han/agents/Leo/CLAUDE.md, and we cd there so Claude Code loads it as the project
# config — not the hand-tended repo-root CLAUDE.md. (Phase 2 strips the repo-root
# ## Identity once this is proven live — see the de-id plan.)
AGENT_WORKING_DIR="$HOME/.han/agents/Leo"
AGENT_SWAP_COMPRESSED="session-swap.md"
AGENT_SWAP_FULL="session-swap-full.md"

# Identity comes from the Garden Manifest via the shared generator (S199 P4+P5 —
# identity-as-config; supersedes the per-launcher heredoc + envsubst). The generator
# derives the agent working dir + all template vars from the manifest by slug and
# fails loud on a missing identity. The gatekeeper template stays Leo+Darron's; never write it here.
generate_claude_md() {
    ( cd "$SCRIPT_DIR/src/server" && NODE_PATH="$(pwd)/node_modules" \
        npx tsx ../../scripts/generate-agent-claude-md.ts "$AGENT_SLUG" )
}

# Colours
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

print_usage() {
    cat << EOF
hanleo — wake Leo in a tended session

Usage:
    hanleo [OPTIONS] [-- CLAUDE_ARGS...]

Options:
    --list, -l      List active Leo sessions
    --attach, -a    Attach to an existing Leo session
    --status, -s    Show status of Leo sessions
    --kill          Kill all Leo sessions
    --warm          Check out a pre-warmed pool stem (the DEFAULT since the msz950i2 land,
                    2026-08-19). WAITS for a warm stem rather than falling back cold.
    --cold          Force the classic cold launch (the escape hatch, DEC-104: an escape,
                    never a constraint). Passing claude args via -- also implies cold
                    (a running stem cannot take launch flags).
    fable|opus|sonnet|haiku   Cast the checked-out stem to this model family (bare alias,
                    DEC-104 — floats to the family head). Default: fable.
    --help, -h      Show this help message

Examples:
    hanleo                    # Wake Leo
    hanleo --list             # List Leo sessions
    hanleo --attach           # Attach to Leo session
    hanleo -- --model opus    # Pass args to claude
EOF
}

list_sessions() {
    echo -e "${BLUE}Active Leo sessions:${NC}"
    local sessions
    sessions=$(tmux list-sessions 2>/dev/null | grep "^${SESSION_PREFIX}" || true)

    if [[ -z "$sessions" ]]; then
        echo -e "${YELLOW}  No active sessions${NC}"
        return 1
    fi

    echo "$sessions" | while read -r line; do
        echo -e "  ${GREEN}$line${NC}"
    done
    return 0
}

show_status() {
    echo -e "${BLUE}=== Leo Status ===${NC}\n"
    echo -e "${BLUE}Sessions:${NC}"
    list_sessions || true
    echo

    echo -e "${BLUE}Pending prompts:${NC}"
    local pending_dir="$HAN_DIR/pending"
    if [[ -d "$pending_dir" ]]; then
        local count
        count=$(find "$pending_dir" -name "*.json" 2>/dev/null | wc -l | tr -d ' ')
        if [[ "$count" -gt 0 ]]; then
            echo -e "  ${YELLOW}$count pending prompt(s)${NC}"
        else
            echo -e "  ${GREEN}No pending prompts${NC}"
        fi
    else
        echo -e "  ${GREEN}No pending prompts${NC}"
    fi
}

attach_session() {
    local sessions
    sessions=$(tmux list-sessions -F "#{session_name}" 2>/dev/null | grep "^${SESSION_PREFIX}" || true)

    if [[ -z "$sessions" ]]; then
        echo -e "${RED}No active Leo sessions to attach to${NC}"
        exit 1
    fi

    local count
    count=$(echo "$sessions" | wc -l | tr -d ' ')

    if [[ "$count" -eq 1 ]]; then
        tmux attach-session -t "$sessions"
    else
        echo -e "${BLUE}Multiple sessions found. Select one:${NC}"
        local i=1
        echo "$sessions" | while read -r s; do
            echo "  $i) $s"
            ((i++))
        done

        read -rp "Enter number: " choice
        local selected
        selected=$(echo "$sessions" | sed -n "${choice}p")

        if [[ -n "$selected" ]]; then
            tmux attach-session -t "$selected"
        else
            echo -e "${RED}Invalid selection${NC}"
            exit 1
        fi
    fi
}

# ── Warm checkout — SHARED leg (DEC-081: one path, many agents) ──────────────
# ensure_server + warm_checkout live in scripts/lib/launcher-warm-checkout.sh so
# hanjim/hantenshi/hancasey source the same audited functions rather than growing
# twins (extracted 2026-08-19; the extraction also fixed the M2 free-stem attach).
source "$SCRIPT_DIR/scripts/lib/launcher-warm-checkout.sh"

kill_sessions() {
    local sessions
    sessions=$(tmux list-sessions -F "#{session_name}" 2>/dev/null | grep "^${SESSION_PREFIX}" || true)

    if [[ -z "$sessions" ]]; then
        echo -e "${YELLOW}No active sessions${NC}"
        return 0
    fi

    echo "$sessions" | while read -r s; do
        echo -e "Killing session: ${RED}$s${NC}"
        tmux kill-session -t "$s" 2>/dev/null || true
    done

    echo -e "${GREEN}Done${NC}"
}

start_session() {
    local claude_args=("$@")
    local session_name="${SESSION_PREFIX}-$$"

    mkdir -p "$HAN_DIR/pending" "$HAN_DIR/resolved"

    if ! command -v tmux &> /dev/null; then
        echo -e "${RED}Error: tmux is required but not installed${NC}"
        exit 1
    fi

    # Phase A.5 (DEC-083): pre-flight identity-file integrity gate.
    # Aborts the launcher if signature verification fails for structural reasons
    # (file added/removed, invalid signature, missing manifest/pubkey). Content-only
    # edits auto-resign per option (iii) — verify-and-resign with audit log.
    echo -e "${BLUE}Verifying ${AGENT_SLUG} identity manifest...${NC}"
    if ! ( cd "$SCRIPT_DIR/src/server" && npx tsx ../../scripts/verify-identity-files.ts --agent="$AGENT_SLUG" --entry-point=hanleo-launcher ); then
        echo -e "${RED}HALT: identity verification failed for agent ${AGENT_SLUG}.${NC}"
        echo -e "${RED}See ~/.han/health/integrity-failures.jsonl for the receipt.${NC}"
        echo -e "${YELLOW}If the change is intentional, re-sign with:${NC}"
        echo -e "${YELLOW}  cd $SCRIPT_DIR/src/server && npx tsx ../../scripts/sign-identity-files.ts --agent=$AGENT_SLUG${NC}"
        exit 1
    fi

    echo -e "${BLUE}Waking Leo: ${GREEN}$session_name${NC}"
    echo -e "${BLUE}Server port: ${GREEN}${AGENT_PORT}${NC}"

    export HAN_SESSION="$session_name"
    export AGENT_SURFACE AGENT_SLUG AGENT_NAME AGENT_MEMORY_DIR AGENT_FRACTAL_DIR \
        AGENT_GRADIENT_SOURCE_DIR AGENT_CONVERSATION_ROLE AGENT_COUNTERPART_NAME

    # Generate Leo's CLAUDE.md from the gatekeeper template BEFORE Claude Code starts
    # (Phase 1 de-id, mirrors hanjim). Claude Code loads the generated file as the project
    # CLAUDE.md via the agent working directory (-c below) — identity from the generated
    # agent-dir file, not the repo root.
    generate_claude_md
    echo -e "${BLUE}Rendered CLAUDE.md: ${GREEN}${GENERATED_FILE:-the agent CLAUDE.md}${NC} from template"

    # All AGENT_* vars forwarded via -e so they're visible inside the tmux session
    # regardless of tmux server state. -c sets the session cwd to Leo's agent dir so the
    # generated CLAUDE.md is the loaded project CLAUDE.md (Phase 1 de-id).
    tmux new-session -d -s "$session_name" \
        -e "HAN_SESSION=$session_name" \
        -e "AGENT_SLUG=$AGENT_SLUG" \
        -e "AGENT_NAME=$AGENT_NAME" \
        -e "AGENT_MEMORY_DIR=$AGENT_MEMORY_DIR" \
        -e "AGENT_FRACTAL_DIR=$AGENT_FRACTAL_DIR" \
        -e "AGENT_GRADIENT_SOURCE_DIR=$AGENT_GRADIENT_SOURCE_DIR" \
        -e "AGENT_CONVERSATION_ROLE=$AGENT_CONVERSATION_ROLE" \
        -e "AGENT_COUNTERPART_NAME=$AGENT_COUNTERPART_NAME" \
        -e "AGENT_SURFACE=$AGENT_SURFACE" \
        -e "AGENT_SWAP_COMPRESSED=$AGENT_SWAP_COMPRESSED" \
        -e "AGENT_SWAP_FULL=$AGENT_SWAP_FULL" \
        -c "$AGENT_WORKING_DIR"

    # Start server in a bottom pane (20% height) under the auto-restart watchdog.
    # See hanjim launcher for full rationale (Apr 20 → Apr 24 ghost-server drift).
    # F-J1 (Jim's diff-audit, msz950i2 2026-08-19): never stack a second server. If the
    # API already answers — the standalone server-leo after a warm-mode empty-pool
    # fallback, or any prior seat's pane — a pane-spawned twin cannot bind, crash-loops
    # every ~2s, and each loop CLOBBERS ~/.han/leo-server.pid (the PID deploy-restarts
    # SIGTERM) — the restart mechanism would aim at a corpse. One server per identity,
    # whoever started it; the watchdog stays dumb (cure (a)).
    if curl -sk -o /dev/null -m 3 "https://localhost:${AGENT_PORT}/api/analytics" 2>/dev/null; then
        echo -e "${GREEN}Server already answering on ${AGENT_PORT} — not spawning a second (F-J1)${NC}"
    else
        tmux split-window -t "$session_name" -v -l 20% -d \
            "$SCRIPT_DIR/scripts/agent-server-watchdog.sh $AGENT_SLUG $AGENT_PORT '$SCRIPT_DIR/src/server'"
    fi

    # Select the top pane (Claude Code) and launch
    tmux select-pane -t "$session_name"
    if [[ ${#claude_args[@]} -gt 0 ]]; then
        tmux send-keys -t "$session_name" "claude-logged ${claude_args[*]}" Enter
    else
        tmux send-keys -t "$session_name" "claude-logged" Enter
    fi

    echo -e "${GREEN}Leo session started${NC}"
    echo -e "Attach with: ${YELLOW}hanleo --attach${NC}"
    echo -e "Or directly: ${YELLOW}tmux attach -t $session_name${NC}"
    echo

    tmux attach-session -t "$session_name"
}

# Parse arguments
CLAUDE_ARGS=()
WARM_MODE=1      # DEFAULT since the land (Darron's word, 2026-08-19 ~3:29 PM; Jim GREEN + F-J1 folded)
CAST_MODEL="fable"   # bare alias, DEC-104 — `hanleo opus` etc. selects the cast family
while [[ $# -gt 0 ]]; do
    case $1 in
        --list|-l)
            list_sessions
            exit $?
            ;;
        --attach|-a)
            attach_session
            exit $?
            ;;
        --status|-s)
            show_status
            exit 0
            ;;
        --kill)
            kill_sessions
            exit 0
            ;;
        --warm)
            WARM_MODE=1
            shift
            ;;
        --cold)
            WARM_MODE=0
            shift
            ;;
        fable|opus|sonnet|haiku)
            CAST_MODEL="$1"
            WARM_MODE=1   # naming a cast implies the warm path (a cold seat takes -- --model)
            shift
            ;;
        --help|-h)
            print_usage
            exit 0
            ;;
        --)
            shift
            CLAUDE_ARGS=("$@")
            break
            ;;
        *)
            CLAUDE_ARGS+=("$1")
            shift
            ;;
    esac
done

# Explicit claude args imply the cold path — a running stem cannot take launch flags.
if [[ ${#CLAUDE_ARGS[@]} -gt 0 ]]; then
    WARM_MODE=0
fi

if [[ "$WARM_MODE" -eq 1 ]]; then
    warm_checkout "$CAST_MODEL" && exit 0
    # NO FALLTHROUGH (Darron's ruling, 2026-08-20 ~22:18: "simply don't fall back, wait").
    # warm_checkout has already waited for the pool and reported loudly; seating a human
    # on the lease-less classic path behind their back is the failure this replaces.
    # `--cold` (below) remains the deliberate escape — DEC-104: an escape, never a constraint.
    exit 1
fi

start_session "${CLAUDE_ARGS[@]+"${CLAUDE_ARGS[@]}"}"
