[Unit]
Description=Jemma — Discord message dispatcher service
After=network.target han-server.service

[Service]
Type=simple
WorkingDirectory=%h/Projects/han/src/server
ExecStart=%h/Projects/han/src/server/node_modules/.bin/tsx jemma.ts
Restart=always
RestartSec=5
Environment=HOME=%h
Environment=PATH=%h/.nvm/versions/node/v23.9.0/bin:/usr/local/bin:/usr/bin:/bin
Environment=OLLAMA_MODEL=gemma3:4b
Environment=NODE_TLS_REJECT_UNAUTHORIZED=0
EnvironmentFile=%h/Projects/han/.env
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jemma

[Install]
WantedBy=default.target
